{
  "schema_version": "1.0",
  "skill_version": "0.2.1",
  "input": {
    "required": ["hypothesis_id", "evidence_ids", "claim"],
    "constraints": ["evidence_ids must contain at least one resolvable ID"]
  },
  "output": {
    "schema": "../../../schemas/plan.schema.json",
    "required": ["plan_id", "hypothesis_id", "objective", "changes", "command", "success_criteria", "budget", "risk_level", "approval_required", "rollback", "forbidden_changes"],
    "constraints": ["changes contains exactly one item", "metric.py and datasets remain immutable"]
  },
  "errors": ["EVIDENCE_MISSING", "UNSUPPORTED_CHANGE", "BUDGET_INVALID", "ROLLBACK_MISSING", "SCHEMA_INVALID", "POLICY_REJECTED"]
}

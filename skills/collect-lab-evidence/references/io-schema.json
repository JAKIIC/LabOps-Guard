{
  "schema_version": "1.0",
  "skill_version": "0.2.1",
  "input": {
    "required": ["task_id", "incident_id", "snapshot", "allowed_list", "audit_dir", "verification", "workspace"],
    "path_policy": "all inputs explicitly supplied; workspace is the only writable root"
  },
  "output": {

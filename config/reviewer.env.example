# Copy this file to an ignored local environment file and replace placeholders locally.
# Never commit the copied file or paste its values into logs, screenshots or Evidence.
LABOPS_MATRIX_HOMESERVER=http://127.0.0.1:18080
LABOPS_MATRIX_ACCESS_TOKEN=replace-locally
LABOPS_MATRIX_ROOM_MAP=config/reviewer-room-map.json

# Public identifiers only. The pack-check command verifies these against the runtime lock.
LABOPS_AGENTTEAMS_VERSION=v1.1.2
LABOPS_REVIEWER_MODE=quick

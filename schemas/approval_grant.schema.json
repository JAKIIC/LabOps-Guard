{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labops://schemas/approval_grant.schema.json",
  "title": "ApprovalGrant v1",
  "type": "object",
  "required": [
    "schema_version",
    "approval_id",
    "task_id",
    "incident_id",
    "plan_id",
    "canonical_plan_sha256",
    "run_id",
    "decision",
    "approved_scope",
    "allowed_side_effects",
    "protected_resources",
    "resource_budget",
    "decided_by",
    "approved_at",
    "expires_at",
    "nonce"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "incident_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "canonical_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "decision": {"const": "APPROVED"},
    "approved_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_side_effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "protected_resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resource_budget": {"type": "object"},
    "decided_by": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 8}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labops://schemas/skill_registry.schema.json",
  "title": "SkillRegistry",
  "type": "object",
  "required": ["schema_version", "skills"],
  "properties": {
    "schema_version": {"type": "string"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["skill_id", "version", "owner_agents", "io_schema", "tool_dependencies", "invocation_condition", "policy_class", "failure_states", "audit_events", "lifecycle"],
        "properties": {
          "skill_id": {"type": "string"},
          "version": {"type": "string"},
          "owner_agents": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "io_schema": {"type": "string"},
          "tool_dependencies": {"type": "array", "items": {"type": "string"}},
          "invocation_condition": {"type": "string"},
          "policy_class": {"type": "string", "enum": ["read_only_auto", "manual_approval", "forbidden"]},
          "failure_states": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "audit_events": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "lifecycle": {"type": "string", "enum": ["active", "deprecated"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labops://schemas/agentteams_skill_deployment.schema.json",
  "title": "AgentTeamsSkillDeployment",
  "type": "object",
  "required": ["schema_version", "agentteams_version", "runtime_family", "deployments"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "agentteams_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "runtime_family": {"type": "string"},
    "deployments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["runtime_agent_id", "canonical_agent_id", "container_name", "skills_root", "skill_ids"],
        "properties": {
          "runtime_agent_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "canonical_agent_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "container_name": {"type": "string", "pattern": "^hiclaw-[a-z0-9-]+$"},
          "skills_root": {"type": "string", "pattern": "^/root/[a-z0-9./-]+/skills$"},
          "skill_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

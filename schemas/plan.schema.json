{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labops://schemas/plan.schema.json",
  "title": "ExperimentPlan",
  "type": "object",
  "required": ["plan_id", "hypothesis_id", "objective", "changes", "command", "success_criteria", "budget", "risk_level", "approval_required", "rollback"],
  "properties": {
    "plan_id": {"type": "string"},
    "hypothesis_id": {"type": "string"},
    "objective": {"type": "string"},
    "changes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}},
    "command": {"type": "string"},
    "success_criteria": {"type": "object"},
    "budget": {"type": "object"},
    "risk_level": {"type": "string", "enum": ["L0", "L1", "L2", "L3"]},
    "approval_required": {"type": "boolean"},
    "rollback": {"type": "string"}
  },
  "additionalProperties": true
}

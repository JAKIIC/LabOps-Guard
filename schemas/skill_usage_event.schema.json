{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "labops://schemas/skill_usage_event.schema.json",
  "title": "LiveAgentTeamsSkillUsageEvent",
  "description": "Validation contract for a Skill event emitted by a future real AgentTeams live run. This schema does not create events and is not historical execution evidence.",
  "type": "object",
  "required": [
    "schema_version",
    "run_mode",
    "event_id",
    "task_id",
    "incident_id",
    "skill_id",
    "skill_version",
    "owner_agent",
    "input_schema_version",
    "output_schema_version",
    "started_at",
    "completed_at",
    "status",
    "input_artifact_refs",
    "output_artifact_refs",
    "trace_reference"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "run_mode": {"type": "string", "enum": ["LIVE_AGENTTEAMS"]},
    "event_id": {"type": "string", "pattern": "^\\S+$"},
    "task_id": {"type": "string", "pattern": "^\\S+$"},
    "incident_id": {"type": "string", "pattern": "^\\S+$"},
    "skill_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "skill_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner_agent": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "input_schema_version": {"type": "string"},
    "output_schema_version": {"type": "string"},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"},
    "completed_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"},
    "status": {"type": "string", "enum": ["STARTED", "COMPLETED", "BLOCKED", "FAILED"]},
    "input_artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.).+"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "output_artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.).+"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "trace_reference": {
      "type": "object",
      "required": ["source", "event_id"],
      "properties": {
        "source": {"type": "string", "enum": ["matrix", "agentteams"]},
        "event_id": {"type": "string", "pattern": "^\\S+$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

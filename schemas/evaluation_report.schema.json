{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labops-guard.local/schemas/evaluation_report.schema.json",
  "title": "Trust Evaluation Suite report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_name",
    "suite_version",
    "scope",
    "focus_areas",
    "case_count",
    "metrics",
    "status",
    "results"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0"]},
    "suite_name": {"type": "string", "enum": ["Trust Evaluation Suite"]},
    "suite_version": {"type": "string", "enum": ["1.0"]},
    "scope": {"type": "string"},
    "focus_areas": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}},
    "case_count": {"type": "integer", "minimum": 8, "maximum": 12},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_violation_prevention_rate",
        "evidence_completeness_rate",
        "false_resolution_rate",
        "independent_audit_accuracy"
      ],
      "properties": {
        "policy_violation_prevention_rate": {"type": "object"},
        "evidence_completeness_rate": {"type": "object"},
        "false_resolution_rate": {"type": "object"},
        "independent_audit_accuracy": {"type": "object"}
      }
    },
    "status": {"type": "string", "enum": ["PASS", "FAIL"]},
    "results": {"type": "array", "minItems": 8, "maxItems": 12, "items": {"type": "object"}}
  }
}
